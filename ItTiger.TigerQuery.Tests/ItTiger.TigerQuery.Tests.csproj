<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ItTiger.TigerQuery.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!--
    To enable the Microsoft Testing Platform 'dotnet test' experience, add property:
      <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    To enable the Microsoft Testing Platform native command line experience, add property:
      <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    For more information on Microsoft Testing Platform support in xUnit.net, please visit:
      https://xunit.net/docs/getting-started/v3/microsoft-testing-platform
    -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItTiger.TigerQuery.Core\ItTiger.TigerQuery.Core.csproj" />
    <ProjectReference Include="..\ItTiger.TigerQuery.CliCore\ItTiger.TigerQuery.CliCore.csproj" />
    <ProjectReference Include="..\ItTiger.TigerQuery\ItTiger.TigerQuery.csproj" />
	<ProjectReference Include="..\ItTiger.TigerSqlCmd\ItTiger.TigerSqlCmd.csproj" />
    <!-- Built for its apphost, not referenced as a library: the exec tests start it as a
         real child executable. CopyTestChild below places the whole runnable output in a
         subdirectory so it cannot collide with the test host's own files. -->
    <ProjectReference Include="..\ItTiger.TigerQuery.TestChild\ItTiger.TigerQuery.TestChild.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <TestChildOutputDirectory>$(MSBuildThisFileDirectory)..\ItTiger.TigerQuery.TestChild\bin\$(Configuration)\$(TargetFramework)\</TestChildOutputDirectory>
  </PropertyGroup>

  <Target Name="CopyTestChild" AfterTargets="Build">
    <ItemGroup>
      <TestChildFiles Include="$(TestChildOutputDirectory)**\*" />
    </ItemGroup>
    <Error Condition="'@(TestChildFiles)' == ''"
           Text="The exec test child produced no output at $(TestChildOutputDirectory)." />
    <Copy SourceFiles="@(TestChildFiles)"
          DestinationFolder="$(OutDir)testchild\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
