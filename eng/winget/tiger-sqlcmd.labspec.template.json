{
  "schemaVersion": 1,
  "name": "tiger-sqlcmd-winget",
  "package": {
    "identifier": "ItTiger.TigerSqlCmd",
    "version": "0.0.0",
    "productCode": "ItTiger.TigerSqlCmd"
  },
  "manifestDirectory": "manifests",
  "installer": {
    "path": "installer.exe",
    "type": "exe",
    "scope": "machine",
    "architecture": "x64",
    "expectedUrl": "https://github.com/rkozlowski/TigerQuery/releases/download/v0.0.0/TigerSqlCmd-0.0.0-Setup.exe",
    "successExitCodes": [0]
  },
  "hashMismatchProbe": {
    "enabled": true,
    "expectedOutputPattern": "(?i)hash"
  },
  "expected": {
    "installRoot": "%ProgramFiles%\\TigerSqlCmd",
    "files": [
      "tiger-sqlcmd.exe",
      "tiger-sqlcmd.dll",
      "ItTiger.TigerQuery.Core.dll",
      "LICENSE.txt",
      "THIRD-PARTY-NOTICES.md",
      "PRIVACY.md"
    ],
    "minimumFileCount": 60,
    "versionFile": "tiger-sqlcmd.exe",
    "machinePathEntries": ["%ProgramFiles%\\TigerSqlCmd"],
    "commands": ["tiger-sqlcmd"],
    "dependencies": [
      {
        "packageIdentifier": "Microsoft.DotNet.Runtime.10",
        "presentWhenPathExists": "%ProgramFiles%\\dotnet\\dotnet.exe",
        "installer": {
          "url": "https://aka.ms/dotnet/10.0/dotnet-runtime-win-x64.exe",
          "arguments": ["/install", "/quiet", "/norestart"]
        }
      }
    ],
    "smoke": [
      {
        "name": "version",
        "command": "tiger-sqlcmd",
        "arguments": ["--version"],
        "expectedExitCode": 0,
        "expectedOutputPattern": "TigerSqlCmd version {version}"
      },
      {
        "name": "help",
        "command": "tiger-sqlcmd",
        "arguments": ["--help"],
        "expectedExitCode": 0,
        "expectedOutputPattern": "tiger-sqlcmd"
      },
      {
        "name": "connection-list",
        "command": "tiger-sqlcmd",
        "arguments": ["connection", "list", "--non-interactive"],
        "expectedExitCode": 0
      }
    ]
  }
}
