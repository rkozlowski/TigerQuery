<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Short, stable name: exec tests build child command lines by hand. -->
    <AssemblyName>tq-test-child</AssemblyName>
    <RootNamespace>ItTiger.TigerQuery.TestChild</RootNamespace>
    <!-- A test asset, never shipped and never part of a release package. -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- The apphost is the point: exec tests need a real executable to start, including
         one copied to a directory whose name contains spaces. -->
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
</Project>
